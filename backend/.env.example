PORT=4000
DATABASE_URL=postgres://localhost:5432/rakaez
NODE_ENV=development
# Must be true in production; certificate validation remains enabled.
DB_SSL=false
# Optional override. When empty, the bundled official Supabase root CA is used.
DB_SSL_CA_FILE=
DB_POOL_MAX=10
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
# Must be true in production. Configure TRUST_PROXY only behind a trusted proxy.
ENFORCE_HTTPS=false
PAYMENTS_ENABLED=false
PUBLIC_REGISTRATION_ENABLED=false
MOYASAR_TIMEOUT_MS=15000

# سرّ توقيع رموز الدخول (JWT) — لازم تغيّره لقيمة عشوائية طويلة قبل النشر
# الفعلي؛ القيمة الافتراضية بالكود غير آمنة وللتطوير المحلي فقط.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
SESSION_TTL_HOURS=12

# HMAC pepper used to pseudonymize network addresses, user agents, and login
# identifiers in security records. Generate independently from JWT_SECRET.
SECURITY_EVENT_PEPPER=replace-with-a-separate-random-secret-of-at-least-32-characters

# المفتاح السري يبقى في الخادم فقط. المفتاح القابل للنشر يضبط في frontend.
MOYASAR_SECRET_KEY=sk_test_xxx
MOYASAR_CALLBACK_URL=http://localhost:5173

# ZATCA Phase 2 is fail-closed. Keep disabled until a compliant UBL signing
# module has passed the official SDK/simulation checks. Store real values in
# the deployment secret manager, never in this file or Git.
ZATCA_INTEGRATION_ENABLED=false
ZATCA_ENVIRONMENT=simulation
# Temporary single-tenant safety binding. The CSID below may only be used for
# this organization id. Multi-tenant production requires a per-organization,
# per-EGS secret broker instead of one shared process-level credential.
ZATCA_ORGANIZATION_ID=
ZATCA_SIGNING_MODULE_APPROVED=false
ZATCA_PRODUCTION_APPROVED=false
ZATCA_TIMEOUT_MS=15000
ZATCA_BINARY_SECURITY_TOKEN=
ZATCA_SECRET=

# Run `npm run monitor:security` every five minutes in the deployment
# scheduler. Exit code 2 means the hosting alert channel should notify the
# security owner; the command emits aggregate counts only.
SECURITY_MONITOR_HIGH_EVENT_THRESHOLD=1

# Licensed external automotive catalogs. Both remain fail-closed until a
# written B2B licence, official API documentation, and test credentials are
# approved. Never put these keys in the frontend.
CATALOG_7ZAP_LEVAM_ENABLED=false
CATALOG_7ZAP_LEVAM_LICENSE_APPROVED=false
LEVAM_API_KEY=
CATALOG_PARTSOUQ_ENABLED=false
CATALOG_PARTSOUQ_LICENSE_APPROVED=false
PARTSOUQ_API_KEY=
