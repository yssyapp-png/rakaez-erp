PORT=4000
DATABASE_URL=postgres://localhost:5432/rakaez
NODE_ENV=development
DB_SSL=false
DB_POOL_MAX=10
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ENFORCE_HTTPS=false
PAYMENTS_ENABLED=false
MOYASAR_TIMEOUT_MS=15000

# سرّ توقيع رموز الدخول (JWT) — لازم تغيّره لقيمة عشوائية طويلة قبل النشر
# الفعلي؛ القيمة الافتراضية بالكود غير آمنة وللتطوير المحلي فقط.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h

# المفتاح السري يبقى في الخادم فقط. المفتاح القابل للنشر يضبط في frontend.
MOYASAR_SECRET_KEY=sk_test_xxx
MOYASAR_CALLBACK_URL=http://localhost:5173
